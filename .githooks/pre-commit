#!/bin/sh

# =============================================================================
# Pre-commit Hook — Cosmetics Finder (Skin Analysis)
# =============================================================================
# Runs ESLint on staged files and full verification before commit.
# =============================================================================

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}  Pre-commit Hook — Cosmetics Finder${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Get all staged .ts and .tsx files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(ts|tsx)$" || true)

if [ -z "$STAGED_FILES" ]; then
  echo -e "${YELLOW}⚠ No staged TypeScript files found. Skipping lint.${NC}"
else
  echo -e "${CYAN}Running ESLint on staged files...${NC}"
  echo "$STAGED_FILES" | xargs npx eslint --fix || true
  git add $STAGED_FILES
  echo -e "${GREEN}✔ ESLint completed${NC}"
fi

echo ""
echo -e "${CYAN}Running full project verification...${NC}"
echo ""

if bash scripts/verify-all.sh; then
  echo ""
  echo -e "${GREEN}✔ Pre-commit hook completed successfully.${NC}"
else
  echo ""
  echo -e "${RED}✖ Verification failed! Commit aborted.${NC}"
  echo -e "${RED}  Please fix the errors above and try again.${NC}"
  exit 1
fi
