#!/bin/sh

# =============================================================================
# Prepare-commit-msg Hook — Cosmetics Finder (Skin Analysis)
# =============================================================================
# Adds branch name to commit message for traceability.
# Skips for merge commits and amends.
# =============================================================================

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Skip for merge commits, amends, or squashes
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ] || [ "$COMMIT_SOURCE" = "commit" ]; then
  exit 0
fi

# Get current branch name
BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Skip if not on a branch (detached HEAD)
if [ -z "$BRANCH_NAME" ]; then
  exit 0
fi

# Skip if on main or develop branch
if [ "$BRANCH_NAME" = "main" ] || [ "$BRANCH_NAME" = "develop" ]; then
  exit 0
fi

# Extract ticket ID from branch name (e.g., feature/SKM-123-add-login -> SKM-123)
TICKET_ID=$(echo "$BRANCH_NAME" | grep -oE "SKM-[0-9]+" || echo "")

# Add branch reference if ticket found
if [ -n "$TICKET_ID" ]; then
  sed -i.bak "1s/^/[$TICKET_ID] /" "$COMMIT_MSG_FILE"
  rm -f "${COMMIT_MSG_FILE}.bak"
fi

exit 0
